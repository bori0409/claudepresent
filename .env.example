# Copy to .env.local and fill in. Without these the app runs in LOCAL mode
# (localStorage + cross-tab sync on one machine) — fine for rehearsal, but
# phones will NOT sync to the projector. Fill these in before the workshop.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The public URL the QR code encodes. Set to your deployed /join URL.
VITE_JOIN_URL=https://YOUR-SITE.netlify.app/join
